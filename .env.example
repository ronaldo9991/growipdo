# Which model API to use: anthropic or openai (any OpenAI compatible chat completions endpoint)
LLM_PROVIDER=anthropic

# For LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# For LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Web search
TAVILY_API_KEY=

# Two different model ids. The stronger one goes in MODEL_SECOND_OPINION.
MODEL_PRIMARY=
MODEL_SECOND_OPINION=

