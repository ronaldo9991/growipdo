# Which model API to use: anthropic or openai (any OpenAI compatible chat completions endpoint)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Two different model ids. The stronger one goes in MODEL_SECOND_OPINION.
# Anthropic: Haiku 5.5 does the bulk work, Sonnet 5.5 gives the second opinion and writes the summaries.
MODEL_PRIMARY=claude-haiku-5-5
MODEL_SECOND_OPINION=claude-sonnet-5-5
# Reasoning effort for Anthropic models: low (default), medium or high
ANTHROPIC_EFFORT=low

# Web search: tavily, brave, serper or duckduckgo (no key, brittle)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# Optional overrides
# RUNS_DIR=runs
# EVIDENCE_DIR=evidence

# Human gate: when set, every approve, reject, decide and draft action must carry this token
APPROVER_TOKEN=
# Track A weekly schedule, UTC, e.g. "mon 09:00"; empty disables the in-process scheduler
RADAR_SCHEDULE=
RADAR_SUBJECTS=Nidhi Hooda, Growpido
# Claims verified concurrently in Track B
VERIFY_WORKERS=4
