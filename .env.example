# Which model API to use: anthropic or openai (any OpenAI compatible chat completions endpoint)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Two different model ids. The stronger one goes in MODEL_SECOND_OPINION.
MODEL_PRIMARY=
MODEL_SECOND_OPINION=

# Web search: tavily, brave, serper or duckduckgo (no key, brittle)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# Optional overrides
# RUNS_DIR=runs
# EVIDENCE_DIR=evidence
